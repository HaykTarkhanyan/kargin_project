    {
      "start": 43.128,
      "end": 47.487,
      "text": "Ոնց իմացա այսօր թոշակ ենք ստացել ո՞նց"
    },
    {
      "start": 45.967,
      "end": 50.487,
      "text": "կարող է պատահի չգա"
    },
    {
      "start": 47.487,
      "end": 53.088,
      "text": "հա ուրեմն գալու եմ"
    },
    {
