      "text": "բայց"
    },
    {
      "start": 29.864,
      "end": 34.143,
      "text": "ոնց որ լավ մարմին ունի:"
    },
    {
      "start": 36.104,
      "end": 40.578,
      "text": "Հինգը տարի սպս տղամարդու մասին էի"
    },
    {
      "start": 38.424,
      "end": 41.544,
      "text": "երազում:"
    },
    {
      "start": 40.578,
      "end": 43.743,
      "text": "[հոգոց]"
    },
    {
      "start": 41.544,
      "end": 46.624,
      "text": "Չորսից հինգ է պակաս, հեսա հացի խանութը"
    },
    {
      "start": 43.743,
      "end": 51.304,
      "text": "կփակ փակվի ես էլ հաց չունեմ բա ինչ անեմ"
    },
    {
      "start": 46.624,
      "end": 54.544,
      "text": "է լավ սա մեկա խմած է ու պիտի գնա գնամ"
    },
    {
      "start": 51.304,
      "end": 59.183,
      "text": "շուտ հաց առնեմ գամ անտերլիֆտը ինչի չի"
