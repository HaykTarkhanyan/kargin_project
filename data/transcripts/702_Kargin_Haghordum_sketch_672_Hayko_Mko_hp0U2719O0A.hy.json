      "end": 89.794,
      "text": "Լավ, այդ դեպքում ինչի են երկու"
    },
    {
      "start": 87.354,
      "end": 91.314,
      "text": "հոգով: Այս մեկը չէր կարող համ զուգարանը"
    },
    {
      "start": 89.794,
      "end": 92.715,
      "text": "սարքել, համ էլ բաղնիկը:"
    },
    {
      "start": 91.314,
      "end": 93.834,
      "text": "Իհարկե չէր կարող:"
    },
    {
      "start": 92.715,
      "end": 96.555,
      "text": "Ինչի՞:"
    },
    {
      "start": 93.834,
      "end": 99.235,
      "text": "որովհետև ինքը սանտեխնիկայի զուգարանական"
    },
    {
      "start": 96.555,
      "end": 102.915,
      "text": "ֆակուլտետն է ավարտել, իսկ ես բաղնիքականն"
    },
    {
