      "text": "بلدي يا ويلي على"
    },
    {
      "start": 98.991,
      "end": 102.311,
      "text": "և"
    },
    {
      "start": 100.951,
      "end": 103.991,
      "text": "բռնաբարեց:"
    },
    {
      "start": 102.311,
      "end": 106.591,
      "text": "Ի՞նչ"
    },
    {
      "start": 103.991,
      "end": 109.27,
      "text": "բռնաբարեց:"
    },
    {
      "start": 106.591,
      "end": 112.471,
      "text": "Բոլոր աստվածներով եմ երդվում, ես վրես"
    },
    {
      "start": 109.27,
      "end": 113.87,
      "text": "խնդիր կլինեմ: Ազա ինձ այս ստորարարացի"
