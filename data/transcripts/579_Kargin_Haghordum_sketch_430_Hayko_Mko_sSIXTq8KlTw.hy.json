      "text": "Երեքից չորս անգամ"
    },
    {
      "start": 118.191,
      "end": 124.311,
      "text": "ով էր"
    },
    {
      "start": 120.711,
      "end": 124.311,
      "text": "Սուլեյման բռնաբարը:"
    },
    {
      "start": 126.951,
      "end": 133.591,
      "text": "Սուլեյման Ման քանի աղջիկների պատվի հետ է"
    },
    {
      "start": 130.551,
      "end": 136.591,
      "text": "խաղացել այդ տականքը, բա ինչու չէիր"
    },
    {
      "start": 133.591,
      "end": 140.39,
      "text": "գոռում, ինչու օգնության չէիր կանչում,"
    },
