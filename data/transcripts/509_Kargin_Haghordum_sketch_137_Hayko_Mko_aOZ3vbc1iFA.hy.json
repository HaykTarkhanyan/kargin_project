  "title": "Kargin Haghordum sketch 137 (Hayko Mko)",
  "source_lang": "hy",
  "n_events": 61,
  "duration_sec": 237.721,
  "full_text": "I love\nջան\nջան լսել եմ որ գյուղի ամենալավ հեքի ես\nպրոբլեմ ունեմ կուզենի որ ինձ օգնի ջան\nպրոբլեմ ունես\nամուսինս պրոբլեմ ունի\nնկարը բերել ես\nհա ջան իհարկե\nհեսա ջան\nփաստորեն ասում ես պրոբլեմ ունի\nեթե պրոբլեմ ունի ուրեմն ս է\nջան չէ այն մյուսն է\nգույնը դուրս չի գալիս\nջան սառոչկին ա դեղին\nփաստորեն\nինքը սառոչկա էլ ունի Հա ջան,\nլավ չի, լավ չի,\nբա պրոբլեմը իրա ինչումն է\nջան շատ է խմում ամուսն հարբեցող\nկուզենայի որ բուժեինք\nյախու թուղթ ու գիրնավ մի բան գցենք ճաշի\nմեջ բուժվի\nբաներ\nձևեր կա\nԶիգմունդ կա Ֆրեյդ կա նիչե կա\nլսի մարդը երազանք ունի\nհա ջան ունի\nոր շատ ուզենաս կարոես կատարես\nհա ջան կարմ\nեթե ուզում ես մարդ խմելը թարգի գնում ես\nտուն ու դեմը պայման ես դնում հենց ինքը\nխմելդ հարգեց դու կատարում ես իր\nամենացանկալի երազանքը ու այդտեղ երազանքի\nիրականացման ցանկությունը այնքան է\nմեծանում, որ խեղդում է խմելու\nցանկությունը\nու այդտեղ մարդդ թքում է,\nթարգում ա\nմերսի ջան\nդե ես գնամ ջան\nգնա ջան\nջան\nպակա ջան\nջան ջան ջան Ջան, ջան:\nՋան, դու ինձ սիրում ես, ջան:\nՀա, դե անպայման ամեն առավոտ կռվով\nսկսենք:\nՋանո Քո խմելու հետ կապված լավ բան եմ\nմտածել:\nՈւրեմն լսի, քանի լյարդը սաղ է, դու ինձ\nհայր պիտի խմենաս: Խմել եմ ու պիտի խմեմ:\nԵղա՞մ:\nՋան չէ իրոք լավ բան է, քիչ դուր կգա:\nԱսե՞մ:\nԼավ ահա\nջան, պայմանը դու թողնում ես խմելը Հա\nջան, դրա փոխարեն ես ամեն օր հաց ուտելուց\nսեղանին կդնեմ\n3 լտր օղի\nարաչ\nջան լավ էլի ջանաչա",
  "events": [
    {
      "start": 4.965,
      "end": 8.364,
      "text": "I love"
    },
    {
      "start": 21.884,
      "end": 24.884,
      "text": "ջան"
    },
    {
      "start": 25.445,
      "end": 32.925,
      "text": "ջան լսել եմ որ գյուղի ամենալավ հեքի ես"
    },
    {
      "start": 29.325,
      "end": 35.364,
      "text": "պրոբլեմ ունեմ կուզենի որ ինձ օգնի ջան"
    },
    {
      "start": 32.925,
      "end": 36.925,
      "text": "պրոբլեմ ունես"
    },
    {
      "start": 35.364,
      "end": 38.525,
      "text": "ամուսինս պրոբլեմ ունի"
    },
    {
      "start": 36.925,
      "end": 41.565,
      "text": "նկարը բերել ես"
    },
    {
      "start": 38.525,
      "end": 42.565,
      "text": "հա ջան իհարկե"
    },
    {
      "start": 41.565,
      "end": 46.404,
      "text": "հեսա ջան"
    },
    {
      "start": 42.565,
      "end": 50.965,
      "text": "փաստորեն ասում ես պրոբլեմ ունի"
    },
    {
      "start": 46.404,
      "end": 55.685,
      "text": "եթե պրոբլեմ ունի ուրեմն ս է"
    },
    {
      "start": 50.965,
      "end": 55.685,
      "text": "ջան չէ այն մյուսն է"
    },
    {
      "start": 56.844,
      "end": 62.604,
      "text": "գույնը դուրս չի գալիս"
    },
    {
      "start": 58.805,
      "end": 64.525,
      "text": "ջան սառոչկին ա դեղին"
    },
    {
      "start": 62.604,
      "end": 67.604,
      "text": "փաստորեն"
    },
    {
      "start": 64.525,
      "end": 70.325,
      "text": "ինքը սառոչկա էլ ունի Հա ջան,"
    },
    {
      "start": 67.604,
      "end": 72.805,
      "text": "լավ չի, լավ չի,"
    },
    {
      "start": 70.325,
      "end": 76.725,
      "text": "բա պրոբլեմը իրա ինչումն է"
    },
    {
      "start": 72.805,
      "end": 79.084,
      "text": "ջան շատ է խմում ամուսն հարբեցող"
    },
    {
      "start": 76.725,
      "end": 82.644,
      "text": "կուզենայի որ բուժեինք"
    },
    {
      "start": 79.084,
      "end": 85.765,
      "text": "յախու թուղթ ու գիրնավ մի բան գցենք ճաշի"
    },
    {
      "start": 82.644,
      "end": 88.325,
      "text": "մեջ բուժվի"
    },
    {
      "start": 85.765,
      "end": 89.685,
      "text": "բաներ"
    },
    {
      "start": 88.325,
      "end": 95.644,
      "text": "ձևեր կա"
    },
    {
      "start": 89.685,
      "end": 95.644,
      "text": "Զիգմունդ կա Ֆրեյդ կա նիչե կա"
    },
    {
      "start": 95.844,
      "end": 102.325,
      "text": "լսի մարդը երազանք ունի"
    },
    {
      "start": 101.084,
      "end": 106.364,
      "text": "հա ջան ունի"
    },
    {
      "start": 102.325,
      "end": 108.084,
      "text": "որ շատ ուզենաս կարոես կատարես"
    },
    {
      "start": 106.364,
      "end": 111.805,
      "text": "հա ջան կարմ"
    },
    {
      "start": 108.084,
      "end": 115.765,
      "text": "եթե ուզում ես մարդ խմելը թարգի գնում ես"
    },
    {
      "start": 111.805,
      "end": 118.685,
      "text": "տուն ու դեմը պայման ես դնում հենց ինքը"
    },
    {
      "start": 115.765,
      "end": 122.925,
      "text": "խմելդ հարգեց դու կատարում ես իր"
    },
    {
      "start": 118.685,
      "end": 125.165,
      "text": "ամենացանկալի երազանքը ու այդտեղ երազանքի"
    },
    {
      "start": 122.925,
      "end": 128.525,
      "text": "իրականացման ցանկությունը այնքան է"
    },
    {
      "start": 125.165,
      "end": 130.404,
      "text": "մեծանում, որ խեղդում է խմելու"
    },
    {
      "start": 128.525,
      "end": 135.604,
      "text": "ցանկությունը"
    },
    {
      "start": 130.404,
      "end": 135.604,
      "text": "ու այդտեղ մարդդ թքում է,"
    },
    {
      "start": 136.485,
      "end": 140.805,
      "text": "թարգում ա"
    },
    {
      "start": 138.165,
      "end": 142.124,
      "text": "մերսի ջան"
    },
    {
      "start": 140.805,
      "end": 143.644,
      "text": "դե ես գնամ ջան"
    },
    {
      "start": 142.124,
      "end": 144.404,
      "text": "գնա ջան"
    },
    {
      "start": 143.644,
      "end": 146.844,
      "text": "ջան"
    },
    {
      "start": 144.404,
      "end": 151.404,
      "text": "պակա ջան"
    },
    {
      "start": 146.844,
      "end": 151.404,
      "text": "ջան ջան ջան Ջան, ջան:"
    },
    {
      "start": 167.245,
      "end": 172.404,
      "text": "Ջան, դու ինձ սիրում ես, ջան:"
    },
    {
      "start": 172.604,
      "end": 176.604,
      "text": "Հա, դե անպայման ամեն առավոտ կռվով"
    },
    {
      "start": 175.565,
      "end": 179.965,
      "text": "սկսենք:"
    },
    {
      "start": 176.604,
      "end": 181.364,
      "text": "Ջանո Քո խմելու հետ կապված լավ բան եմ"
    },
    {
      "start": 179.965,
      "end": 185.765,
      "text": "մտածել:"
    },
    {
      "start": 181.364,
      "end": 190.124,
      "text": "Ուրեմն լսի, քանի լյարդը սաղ է, դու ինձ"
    },
    {
      "start": 185.765,
      "end": 192.205,
      "text": "հայր պիտի խմենաս: Խմել եմ ու պիտի խմեմ:"
    },
    {
      "start": 190.124,
      "end": 195.765,
      "text": "Եղա՞մ:"
    },
    {
      "start": 192.205,
      "end": 198.765,
      "text": "Ջան չէ իրոք լավ բան է, քիչ դուր կգա:"
    },
    {
      "start": 195.765,
      "end": 198.765,
      "text": "Ասե՞մ:"
    },
    {
      "start": 198.844,
      "end": 203.205,
      "text": "Լավ ահա"
    },
    {
      "start": 204.084,
      "end": 213.644,
      "text": "ջան, պայմանը դու թողնում ես խմելը Հա"
    },
    {
      "start": 207.844,
      "end": 217.205,
      "text": "ջան, դրա փոխարեն ես ամեն օր հաց ուտելուց"
    },
    {
      "start": 213.644,
      "end": 217.205,
      "text": "սեղանին կդնեմ"
    },
    {
      "start": 218.604,
      "end": 222.245,
      "text": "3 լտր օղի"
    },
    {
      "start": 224.725,
      "end": 227.725,
      "text": "արաչ"
    },
    {
      "start": 229.165,
      "end": 232.844,
      "text": "ջան լավ էլի ջանաչա"
    }
  ],
