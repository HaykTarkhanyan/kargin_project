      "text": "նստե"
    },
    {
      "start": 81.198,
      "end": 87.397,
      "text": "Գիտեք, առավոտյան ասեցի մտնել սրճարան, մի"
    },
    {
      "start": 83.958,
      "end": 90.958,
      "text": "բաժակ սուրճ խմեմ և սրճարան մտնելուն պես"
    },
    {
      "start": 87.397,
      "end": 94.718,
      "text": "միանգամից ձեզ նկատեցի ճաշակով հագնված,"
    },
    {
      "start": 90.958,
      "end": 97.718,
      "text": "գեղեցիկ սանրվածքով բարետես մի տղամարդ:"
    },
    {
      "start": 94.718,
      "end": 99.317,
      "text": "Գիտեք, այսօր շատ հազվադեպ են հանդիպում"
    },
    {
      "start": 97.718,
      "end": 101.678,
      "text": "այսպիսի տղամարդիկ:"
    },
    {
      "start": 99.317,
      "end": 105.158,
      "text": "Ճիշտն ասած, դուք էլ, որ հենց նոր մտաք"
    },
    {
      "start": 101.678,
      "end": 108.397,
      "text": "սրճարան, Ես միանգամից ձեզ նկատեցի, շատ"
    },
    {
      "start": 105.158,
      "end": 111.758,
      "text": "կոկիկ հագնված, վստահ, բայց միևնույն"
    },
    {
      "start": 108.397,
      "end": 114.718,
      "text": "ժամանակ սահուն քայլվածքով, արիստոկրատին"
    },
    {
      "start": 111.758,
      "end": 118.158,
      "text": "վայել շարժու ձևով, առնական, բայց"
    },
    {
      "start": 114.718,
      "end": 119.877,
      "text": "միևնույն ժամանակ նուրբ դիմագծերով մի"
    },
    {
      "start": 118.158,
      "end": 121.798,
      "text": "տղամարդ:"
    },
    {
      "start": 119.877,
      "end": 124.198,
      "text": "Ես էլ նստած մտածում եմ՝ ինչու միայն"
    },
    {
      "start": 121.798,
      "end": 126.638,
      "text": "կսրչեմ, եթե կարող եմ մոտենալ ձեզ և մենք"
    },
    {
      "start": 124.198,
      "end": 128.478,
      "text": "միասին զրուցելով կսրճենք: Ինձ թվում ա"
    },
    {
      "start": 126.638,
      "end": 129.397,
      "text": "մենք շատ ընդհանուր թեմաներ կունենանք"
    },
    {
      "start": 128.478,
      "end": 132.317,
      "text": "զրուցելու համար:"
    },
    {
      "start": 129.397,
      "end": 134.678,
      "text": "Իմ մտքով էլ դա անցավ: Ճիշտ արեց: որ"
    },
    {
      "start": 132.317,
      "end": 139.118,
      "text": "մոտեցաք երևակային, որ դուք ինձ"
    },
    {
      "start": 134.678,
      "end": 139.118,
      "text": "չմոտենայիք, ես էի ձեզ մոտենալու:"
    },
    {
      "start": 139.478,
      "end": 145.718,
      "text": "Կներեք, իսկ կարո<k է դուք"
    },
    {
      "start": 142.638,
      "end": 147.397,
      "text": "հոմոսեքսուալիստ եք:"
    },
    {
      "start": 145.718,
      "end": 150.278,
      "text": "Չէ,"
    },
    {
      "start": 147.397,
      "end": 153.837,
      "text": "իսկ դուք"
    },
    {
      "start": 150.278,
      "end": 153.837,
      "text": "ես էլ չէ:"
    },
    {
      "start": 154.357,
      "end": 156.598,
      "text": "Ափսոս"
    }
  ],
