    {
      "start": 72.316,
      "end": 79.075,
      "text": "կա, ոնց Կլիենտա ի՞նչ անեմ:"
    },
    {
      "start": 75.476,
      "end": 79.075,
      "text": "Ասա թող ներս գա:"
