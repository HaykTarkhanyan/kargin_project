      "end": 88.835,
      "text": "Ա վարչականիչ ջան:"
    },
    {
      "start": 85.596,
      "end": 92.316,
      "text": "Անցեք, ձեզ սպասում եմ:"
    },
    {
      "start": 88.835,
      "end": 94.916,
      "text": "Չէ, չէ, ցավդ տանեմ, չեմ կարող ընդունեմ:"
    },
    {
      "start": 92.316,
      "end": 97.556,
      "text": "Չեմ կարող, գիտես, կլիենտները լիքն են:"
    },
    {
      "start": 94.916,
      "end": 99.916,
      "text": "Այս ամիս լրիվ լցված է: Ուզում ես փորձի"
    },
    {
      "start": 97.556,
      "end": 103.075,
      "text": "մյուս ամիս կարող է մի ձև տեղը ազատենք,"
    },
    {
      "start": 99.916,
      "end": 104.515,
      "text": "մտցնենք, մի բան անենք: Հա էդ Եղավ, եղավ,"
    },
    {
      "start": 103.075,
      "end": 106.075,
      "text": "չէ, չէ, շնորհակալություն պետք չի"
    },
    {
      "start": 104.515,
      "end": 107.916,
      "text": "հայտնել, հենց կանենք, այդ ժամանակ էլ"
    },
    {
      "start": 106.075,
      "end": 110.236,
      "text": "կհայտնենք,"
    },
    {
      "start": 107.916,
      "end": 112.436,
      "text": "մերսի"
    },
    {
      "start": 110.236,
