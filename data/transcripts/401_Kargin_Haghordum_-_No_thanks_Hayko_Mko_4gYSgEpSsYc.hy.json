  "full_text": "Ես եմ ներքևը քնում,\nասեցի ես եմ քնում\nայ ցավդ տանեմ անցած անգամ ես վերևն եմ\nքնել,\nհա բայց անցած անգամ դու մենակ ես գնացել\nհամեն սուս մնա ուրիշ մարդկանց\nջոկել ում հետ ենք ճամպահում\nոնց որ անգլիացի է\nհա հենց տեսա միանգամից ջոկեցի որ սա\nփարիզից է լավ հլը այն մորդած խնձորը հանի\nմի հատ\nԲերաններիս համը փոխենք\nկանգնի խնձոր բերած էր չորս բոլոր աշածեր\nբոլոր ծառով նախշացել մեջը ոսկով լսած էր\nկարմիր խնձոր բերած էր բոլորը\nբոլորով\nանգլիացուն հյուրասիր\nմեր բազմաչարշար հինավուր ազգախոզանիր\nջան սալատկի սալատկի\nնո նո thanksս\nչես ուզում մենք կուտենք\nկնիկ\nմի հատ լիմոնադ չխմե՞նք էս բերաններից\nխնձորի համը փոխենք\nԽմենք\nՀա ճիշտ է չմտածեն մեր բազմաչարչար\nհինավոր ծազախոզա\nընկեր լիմոնայոգել\nլիմոնե\nնո նո thanksս\nկնիկ ես ջոկի խի սա մեր տվածները չի\nուտում խմում\nինչի\nաս անգելացիկը այդպենս են որ ասում է\nչոփորնի անգլիճան\nհա\nսրանց մինչև չբարևես մի հատ գեղեցիկ ձևով\nչներկայանաս սրանք ոչ թե լիմոնատու ու\nխնձոր էլ վարչի հետ չեն խոսում: Ասում եմ\nերկար ճամփա ենք գնալու այս մարդու հետ,\nարի կլինի մի հատ սիրուն ձևով\nներկայանանք, որ այս լարվածության\nմթնոլորտը այս կուպեից ցավի:\nԸնկեր\nկնիկս\nմայֆռաուլա:\nՄիևա\nեք ջրա առեցեք լմով հիսը փախեցեք հավը\nյուղով տապկեցեք հարկով խանեք",
  "events": [
    {
      "start": 24.252,
      "end": 26.692,
      "text": "Ես եմ ներքևը քնում,"
    },
    {
      "start": 25.453,
      "end": 28.773,
      "text": "ասեցի ես եմ քնում"
    },
    {
      "start": 26.692,
      "end": 29.212,
      "text": "այ ցավդ տանեմ անցած անգամ ես վերևն եմ"
    },
    {
      "start": 28.773,
      "end": 31.373,
      "text": "քնել,"
    },
    {
      "start": 29.212,
      "end": 35.453,
      "text": "հա բայց անցած անգամ դու մենակ ես գնացել"
    },
    {
      "start": 31.373,
      "end": 35.453,
      "text": "համեն սուս մնա ուրիշ մարդկանց"
    },
    {
      "start": 41.212,
      "end": 45.013,
      "text": "ջոկել ում հետ ենք ճամպահում"
    },
    {
      "start": 45.813,
      "end": 49.692,
      "text": "ոնց որ անգլիացի է"
    },
    {
      "start": 47.252,
      "end": 53.652,
      "text": "հա հենց տեսա միանգամից ջոկեցի որ սա"
    },
    {
      "start": 49.692,
      "end": 54.413,
      "text": "փարիզից է լավ հլը այն մորդած խնձորը հանի"
    },
    {
      "start": 53.652,
      "end": 55.973,
      "text": "մի հատ"
    },
    {
      "start": 54.413,
      "end": 60.692,
      "text": "Բերաններիս համը փոխենք"
    },
    {
      "start": 55.973,
      "end": 65.293,
      "text": "կանգնի խնձոր բերած էր չորս բոլոր աշածեր"
    },
    {
      "start": 60.692,
      "end": 70.013,
      "text": "բոլոր ծառով նախշացել մեջը ոսկով լսած էր"
    },
    {
      "start": 65.293,
      "end": 72.813,
      "text": "կարմիր խնձոր բերած էր բոլորը"
    },
    {
      "start": 70.013,
      "end": 75.933,
      "text": "բոլորով"
    },
    {
      "start": 72.813,
      "end": 80.493,
      "text": "անգլիացուն հյուրասիր"
    },
    {
      "start": 75.933,
      "end": 80.493,
      "text": "մեր բազմաչարշար հինավուր ազգախոզանիր"
    },
    {
      "start": 81.212,
      "end": 85.573,
      "text": "ջան սալատկի սալատկի"
    },
    {
      "start": 85.853,
      "end": 92.212,
      "text": "նո նո thanksս"
    },
    {
      "start": 88.333,
      "end": 92.212,
      "text": "չես ուզում մենք կուտենք"
    },
    {
      "start": 94.212,
      "end": 97.493,
      "text": "կնիկ"
    },
    {
      "start": 95.573,
      "end": 98.853,
      "text": "մի հատ լիմոնադ չխմե՞նք էս բերաններից"
    },
    {
      "start": 97.493,
      "end": 101.053,
      "text": "խնձորի համը փոխենք"
    },
    {
      "start": 98.853,
      "end": 101.053,
      "text": "Խմենք"
    },
    {
      "start": 111.973,
      "end": 116.973,
      "text": "Հա ճիշտ է չմտածեն մեր բազմաչարչար"
    },
    {
      "start": 114.773,
      "end": 121.293,
      "text": "հինավոր ծազախոզա"
    },
    {
      "start": 116.973,
      "end": 121.293,
      "text": "ընկեր լիմոնայոգել"
    },
    {
      "start": 121.652,
      "end": 124.652,
      "text": "լիմոնե"
    },
    {
      "start": 125.172,
      "end": 128.773,
      "text": "նո նո thanksս"
    },
    {
      "start": 135.093,
      "end": 138.493,
      "text": "կնիկ ես ջոկի խի սա մեր տվածները չի"
    },
    {
      "start": 137.453,
      "end": 139.413,
      "text": "ուտում խմում"
    },
    {
      "start": 138.493,
      "end": 142.132,
      "text": "ինչի"
    },
    {
      "start": 139.413,
      "end": 143.893,
      "text": "աս անգելացիկը այդպենս են որ ասում է"
    },
    {
      "start": 142.132,
      "end": 144.613,
      "text": "չոփորնի անգլիճան"
    },
    {
      "start": 143.893,
      "end": 147.732,
      "text": "հա"
    },
    {
      "start": 144.613,
      "end": 150.293,
      "text": "սրանց մինչև չբարևես մի հատ գեղեցիկ ձևով"
    },
    {
      "start": 147.732,
      "end": 153.333,
      "text": "չներկայանաս սրանք ոչ թե լիմոնատու ու"
    },
    {
      "start": 150.293,
      "end": 156.172,
      "text": "խնձոր էլ վարչի հետ չեն խոսում: Ասում եմ"
    },
    {
      "start": 153.333,
      "end": 157.692,
      "text": "երկար ճամփա ենք գնալու այս մարդու հետ,"
    },
    {
      "start": 156.172,
      "end": 159.732,
      "text": "արի կլինի մի հատ սիրուն ձևով"
    },
    {
      "start": 157.692,
      "end": 163.933,
      "text": "ներկայանանք, որ այս լարվածության"
    },
    {
      "start": 159.732,
      "end": 163.933,
      "text": "մթնոլորտը այս կուպեից ցավի:"
    },
    {
      "start": 164.453,
      "end": 168.293,
      "text": "Ընկեր"
    },
    {
      "start": 166.613,
      "end": 171.293,
      "text": "կնիկս"
    },
    {
      "start": 168.293,
      "end": 171.293,
      "text": "մայֆռաուլա:"
    },
    {
      "start": 178.172,
      "end": 181.172,
      "text": "Միևա"
    },
    {
      "start": 182.853,
      "end": 191.981,
      "text": "եք ջրա առեցեք լմով հիսը փախեցեք հավը"
    },
    {
      "start": 187.933,
