      "end": 32.487,
      "text": "խոսքի"
    },
    {
      "start": 34.047,
      "end": 37.047,
      "text": "ռուսի"
    },
    {
      "start": 38.967,
      "end": 43.926,
      "text": "ռուսե"
    },
    {
      "start": 40.926,
