      "text": "Աղմենիշ"
    },
    {
      "start": 142.607,
      "end": 144.887,
      "text": "հայ է"
    },
    {
      "start": 143.807,
      "end": 146.646,
      "text": "Ամենիշ"
    },
    {
      "start": 144.887,
      "end": 147.406,
      "text": "հայ"
    },
    {
      "start": 146.646,
      "end": 150.807,
      "text": "Սյունիշտ"
    },
    {
      "start": 147.406,
      "end": 154.607,
      "text": "գնդակարել հենց հիմա արագ գնդակարել սրան"
    },
    {
      "start": 150.807,
      "end": 157.727,
      "text": "Սյունի արա ինչի այ բոշխա արա արա կռիվը"
    },
    {
      "start": 154.607,
      "end": 161.047,
      "text": "պրծավ գլուխդա"
    },
    {
      "start": 157.727,
      "end": 163.487,
      "text": "գերոֆից ինչու միանգամից գնդակ արել ինչու"
    },
    {
      "start": 161.047,
      "end": 165.686,
      "text": "այս մեկին չհարձաքննեցինք"
